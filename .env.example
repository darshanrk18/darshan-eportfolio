# Environment variables
#
# Canonical production URL (used for metadataBase, sitemap, robots, JSON-LD).
# Falls back to https://www.darshankonnur.com when unset.
NEXT_PUBLIC_SITE_URL=https://www.darshankonnur.com

# Google Analytics 4 measurement id (optional — analytics are skipped when unset).
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Supplied automatically by Vercel at build time (footer deploy readout).
# NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA=

# NOTE: the EmailJS variables from the previous implementation
# (NEXT_PUBLIC_EMAILJS_SERVICE_ID / _TEMPLATE_ID / _PUBLIC_KEY) are NO LONGER USED.
